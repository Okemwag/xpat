# Optional PostGIS persistence for runs and evidence. Leave unset to use the local file store (FLOODCAT_STORE_DIR).
FLOODCAT_DATABASE_URL=
FLOODCAT_DB_PASSWORD=floodcat-local-only
FLOODCAT_API_TOKEN=
FLOODCAT_ENV=development
FLOODCAT_CORS_ORIGINS=http://localhost:3000
# AI features (Gemini). Leave blank to run without AI; the app says so where AI would appear.
GEMINI_API_KEY=
# Optional: preferred model, tried first. Then GEMINI_FALLBACK_MODELS in order (busy or retired models fall through).
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest
# Interface
FLOODCAT_STORE_DIR=runtime/store
FLOODCAT_ADMIN_USER=
FLOODCAT_ADMIN_PASSWORD=
FLOODCAT_ALLOW_GUEST=1
FLOODCAT_GUEST_ROLE=reviewer
# Set to 1 to stop place-name lookups against OpenStreetMap Nominatim.
FLOODCAT_OFFLINE=0
