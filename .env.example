# ---------------------------------------------------------------------------------------------
# Xpat configuration. Copy to .env and fill in. Never commit .env (it is git-ignored).
# ---------------------------------------------------------------------------------------------
# production enables strict checks (secret key, scanner, secure cookies)
FLOODCAT_ENV=development

# Database. PostgreSQL in production (run `make migrate`); leave empty for a local SQLite file under FLOODCAT_STORE_DIR.
FLOODCAT_DATABASE_URL=
# used by compose.yaml for the local PostGIS container
FLOODCAT_DB_PASSWORD=floodcat-local-only
FLOODCAT_STORE_DIR=runtime/store

# Encryption key for MFA seeds, SSO secrets and stored inputs. Generate with: uv run flood-cat generate-secret-key
# Required in production; development creates runtime/store/secret.key automatically.
FLOODCAT_SECRET_KEY=

# Public addresses. In production put both behind one domain with a reverse proxy (see deploy/Caddyfile).
# the Streamlit interface
FLOODCAT_APP_URL=http://127.0.0.1:8501
# sign-in pages and API (/auth, /v1)
FLOODCAT_AUTH_URL=http://127.0.0.1:8000
# 1 behind HTTPS (default 1 in production)
FLOODCAT_COOKIE_SECURE=0
# 1 only behind your own reverse proxy (uses X-Forwarded-For)
FLOODCAT_TRUST_PROXY=0
FLOODCAT_CORS_ORIGINS=http://127.0.0.1:8501


RESEND_FROM=
RESEND_API_KEY=

# AI provider: gemini or ollama. Unset = Gemini if GEMINI_API_KEY is set, else Ollama if OLLAMA_MODEL is set, else AI off.
FLOODCAT_AI_PROVIDER=
# Gemini. Leave the key empty to run without AI; the interface says where AI would appear.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest
# Ollama (local model; text never leaves the Ollama host). e.g. `ollama pull llama3.2:3b`
OLLAMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
# Local models on a CPU are slow; documents need a larger context window than Ollama's default.
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=8192
# Flood reports (drainage-deficit factor). Local embedding model files go here (downloaded once, then offline).
FLOODCAT_MODEL_DIR=
# ReliefWeb public reports: a free app name approved at https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
FLOODCAT_QUOTA_AI_USER_PER_HOUR=60
FLOODCAT_QUOTA_AI_ORG_PER_HOUR=600
FLOODCAT_QUOTA_UPLOADS_USER_PER_HOUR=120

# Malware scanning of uploads with ClamAV (host:port or unix:/path). Required in production.
FLOODCAT_CLAMAV=

# Public demo: a separate temporary workspace with the sample portfolio. Turn off for customer deployments.
FLOODCAT_ALLOW_GUEST=0
# Shown as "Request a pilot" on the landing page; hidden when empty.
FLOODCAT_CONTACT_EMAIL=

# Data
# 1 rejects real exposure (e.g. a public demo)
FLOODCAT_SYNTHETIC_ONLY=0
# check new passwords against known breaches (HIBP k-anonymity)
FLOODCAT_BREACH_CHECK=1
# 1 stops place-name lookups against OpenStreetMap Nominatim
FLOODCAT_OFFLINE=0

# Home-page assistant for signed-out visitors: 1 = answer with AI (default outside production), 0 = quote the docs only.
FLOODCAT_ASSISTANT_PUBLIC_AI=
# Model for visitors' questions (gemini | ollama). Default: Gemini when configured, else the local model.
FLOODCAT_ASSISTANT_PROVIDER=
