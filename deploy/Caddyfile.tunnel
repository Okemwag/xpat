# Local single entry point for a Cloudflare quick tunnel (make tunnel). Plain HTTP on 127.0.0.1:8080; Cloudflare adds HTTPS.
# One address for everything, so the HttpOnly session cookie set by /auth is sent to the interface.
{
	admin off
	auto_https off
}

# Any host name (the tunnel's address changes), but only on this machine.
:8080 {
	bind 127.0.0.1
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@api path /auth* /v1* /health
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:8501
	}
}
