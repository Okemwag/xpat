  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Rows"
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          },
          "enhanced": {
            "type": "boolean",
            "title": "Enhanced",
            "default": false
          },
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "AnalysisRequest"
      },
      "ApprovalRequest": {
        "properties": {
          "reviewer": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewer"
          }
        },
        "type": "object",
        "required": [
          "reviewer"
        ],
        "title": "ApprovalRequest"
      },
      "CSVAnalysisRequest": {
        "properties": {
          "csv_text": {
            "type": "string",
            "maxLength": 10000000,
            "minLength": 1,
            "title": "Csv Text"
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          },
          "enhanced": {
            "type": "boolean",
            "title": "Enhanced",
            "default": false
          },
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csv_text"
        ],
        "title": "CSVAnalysisRequest"
      },
      "EvidenceRequest": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Evidence Id"
          },
          "source": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Source"
          },
          "quote": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Quote"
          },
          "event_date": {
            "type": "string",
            "title": "Event Date"
          },
          "location_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Location Name"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "drainage_signal": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Drainage Signal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "source",
          "quote",
          "event_date",
          "location_name",
          "lat",
          "lon",
          "confidence",
          "drainage_signal"
        ],
        "title": "EvidenceRequest"
      },
      "ExtractionRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text"
          },
          "source": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "text",
          "source"
        ],
        "title": "ExtractionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
